[Unit]
Description=Yixianqian H5 Backend (gunicorn, test)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/yixianqian-test/web/backend
Environment=BIND=127.0.0.1:8092
ExecStart=/opt/yixianqian-test/web/backend/venv/bin/gunicorn -c gunicorn.conf.py app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
